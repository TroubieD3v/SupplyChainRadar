# Copy to .env (never commit real values). All settings are optional.
# Port published on 127.0.0.1 by compose
SCRADAR_PORT=8000
# When set, every mutating API call needs "Authorization: Bearer <token>".
SCRADAR_API_TOKEN=
# Override only for a mirror you operate; redirects are never followed.
SCRADAR_OSV_URL=https://api.osv.dev
# Where scans are stored / OSV answers are cached (container defaults shown)
# SCRADAR_DATA_DIR=/data
# SCRADAR_CACHE_DIR=/data/cache
# SCRADAR_ALLOWED_HOSTS=localhost,127.0.0.1
